{
  "description": "crew plugin hooks — short-name slash routing + session health check",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/keyword-router.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT\"/hooks/scripts/session-start.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
